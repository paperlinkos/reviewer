NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://visual_feedback_app:replace-with-local-password@localhost:5432/visual_feedback?schema=public
CORS_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-minimum-32-character-local-secret
BETTER_AUTH_URL=http://localhost:3001/api/auth
STORAGE_PROVIDER=local
# Must be outside any publicly served directory. Created with owner-only permissions.
LOCAL_MEDIA_DIR=/tmp/visual-feedback-media
LOCAL_MEDIA_MAX_UPLOAD_BYTES=26214400
# Required only when STORAGE_PROVIDER=s3 (adapter deferred).
S3_ENDPOINT=
S3_BUCKET=
