{
  "name": "visual-feedback-platform",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": { "node": ">=22.0.0", "pnpm": ">=10.0.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @vfp/api prisma:generate",
    "db:migrate": "pnpm --filter @vfp/api prisma:migrate"
  },
  "pnpm": { "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma", "spawn-sync", "unrs-resolver"] },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
